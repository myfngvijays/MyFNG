{
  "name": "myfng-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/web"
    ],
    "nohoist": [
      "**/apps/mobile/**"
    ]
  },
  "scripts": {
    "web": "cd apps/web && npm run dev",
    "mobile": "cd apps/mobile && npm start",
    "build:web": "cd apps/web && npm run build",
    "build:mobile": "cd apps/mobile && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
