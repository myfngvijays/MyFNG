<!--
  Partner (staff) app release only: merged on top of src/main when APP_VARIANT=partner.
  - Background location: used only by the customer "nearby workshop" alert, which never
    runs for staff logins, so the Partner listing must not request it (Play policy).
  - Media playback foreground service: added by expo-video for background playback.
    Partner only plays the splash video on screen, so the service and permission go.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove"/>

  <application>
    <service
      android:name="expo.modules.video.playbackService.ExpoVideoPlaybackService"
      tools:node="remove"/>
  </application>
</manifest>
