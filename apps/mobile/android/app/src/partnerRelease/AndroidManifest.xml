<!--
  Partner (staff) app release only: merged on top of src/main when APP_VARIANT=partner.
  Background location is used only by the customer "nearby workshop" alert, which never
  runs for staff logins, so the Partner listing must not request it (Play policy).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove"/>
</manifest>
