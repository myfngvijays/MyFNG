# Required — same project as apps/web
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer a dedicated read-only Postgres role key if you have one.
# Service role works but MCP never writes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Mask phones / emails in tool output (default true)
MYFNG_MCP_MASK_PII=true

# Hard cap on rows returned per tool call (default 50, max 100)
MYFNG_MCP_MAX_ROWS=50
